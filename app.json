{
  "expo": {
    "name": "Atmos",
    "slug": "atmos",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#0E0E12",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "com.axiom.atmos"
    },
    "android": {
      "package": "com.axiom.atmos",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0E0E12"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-font"
    ],
    "experiments": {
      "tsconfigPaths": true
    }
  }
}
